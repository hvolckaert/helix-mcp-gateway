# Non-sensitive server policy. The path is relative to this file.
HELIX_CONFIG_PATH=config/helix.yaml

# Local Java process required by AR API.
# The supported series is Developer Studio / AR API 21.30.x. BMC JARs are
# referenced from an authorized local installation and are never committed.
HELIX_ARAPI_BRIDGE_JAR_PATH=arapi-bridge/build/helix-arapi-bridge.jar
HELIX_ARAPI_LIB_DIR="/authorized/path/to/DeveloperStudio/plugins/com.bmc.arsys.studio.api/lib"

# Optional local JSONL audit. The path is relative to this file.
# On POSIX the file uses mode 0600 and rotates at the configured size.
HELIX_AUDIT_LOG_PATH=.local/state/helix-mcp/audit.jsonl
HELIX_AUDIT_LOG_MAX_BYTES=10485760
HELIX_AUDIT_LOG_BACKUP_COUNT=5

# Aggregate metrics and rotated operation events, both without payloads.
HELIX_METRICS_PATH=.local/state/helix-mcp/metrics.json
HELIX_OPERATION_LOG_PATH=.local/state/helix-mcp/operations.jsonl
HELIX_OPERATION_LOG_MAX_BYTES=10485760
HELIX_OPERATION_LOG_BACKUP_COUNT=5

# Encrypted plan persistence. Both paths must be configured together.
# helix-mcp-setup generates a private random key containing exactly 32 bytes.
HELIX_WRITE_PLAN_DB_PATH=.local/state/helix-mcp/write-plans.sqlite3
HELIX_WRITE_PLAN_KEY_PATH=.local/state/helix-mcp/write-plans.key

# One Helix/ARAPI JSON credential per environment.
# Never commit real values.
HELIX_CREDENTIAL_DEV='{"username":"dev-user","password":"dev-password"}'
HELIX_CREDENTIAL_QA='{"username":"qa-user","password":"qa-password"}'
HELIX_CREDENTIAL_PROD='{"username":"prod-user","password":"prod-password"}'
